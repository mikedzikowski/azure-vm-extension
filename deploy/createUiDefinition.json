{
  "$schema": "https://schema.management.azure.com/schemas/0.1.2-preview/CreateUIDefinition.MultiVm.json#",
  "handler": "Microsoft.Azure.CreateUIDef",
  "version": "0.1.2-preview",
  "parameters": {
    "config": {
      "isWizard": false,
      "basics": {
        "description": "Deploy **CrowdStrike Falcon Azure Policy** to automatically install and configure the CrowdStrike Falcon sensor on Azure VMs, VM Scale Sets, and Arc-connected servers.\n\n**This deployment creates Azure Policy definitions and assignments that will:**\n- Detect Windows and Linux VMs, VMSS, and Arc servers\n- Automatically install the CrowdStrike Falcon VM extension\n- Configure sensors with your CrowdStrike API credentials\n- Support multiple authentication methods including Key Vault integration\n\n**Prerequisites:**\n- CrowdStrike API credentials with required permissions\n- Appropriate Azure RBAC permissions (Owner or User Access Administrator recommended)\n- For Key Vault authentication: pre-configured vault with FALCON- prefixed secrets\n\nFor detailed information, see the [CrowdStrike Azure VM Extension documentation](https://github.com/CrowdStrike/azure-vm-extension).",
        "subscription": {
          "constraints": {
            "validations": [
              {
                "permission": "Microsoft.Authorization/policyDefinitions/write",
                "message": "Must have permissions to create policy definitions"
              },
              {
                "permission": "Microsoft.Authorization/policyAssignments/write",
                "message": "Must have permissions to create policy assignments"
              }
            ]
          }
        },
        "resourceGroup": {
          "allowExisting": true
        },
        "location": {
          "visible": false
        }
      }
    },
    "basics": [
      {
        "name": "deploymentScope",
        "type": "Microsoft.Common.DropDown",
        "label": "Deployment scope",
        "defaultValue": "Current subscription",
        "toolTip": "Choose the scope for policy deployment. Subscription scope covers all VMs in this subscription. Management group scope can cover multiple subscriptions.",
        "constraints": {
          "allowedValues": [
            {
              "label": "Current subscription",
              "value": "subscription"
            },
            {
              "label": "Management group",
              "value": "managementgroup"
            }
          ]
        },
        "visible": false
      }
    ],
    "steps": [
      {
        "name": "falconConfig",
        "label": "CrowdStrike Configuration",
        "elements": [
          {
            "name": "authenticationMethod",
            "type": "Microsoft.Common.OptionsGroup",
            "label": "Authentication Method",
            "defaultValue": "OAuth2 Credentials",
            "toolTip": "Choose how to authenticate with the CrowdStrike Falcon Platform",
            "constraints": {
              "allowedValues": [
                {
                  "label": "OAuth2 Credentials",
                  "value": "oauth2"
                },
                {
                  "label": "Access Token",
                  "value": "token"
                },
                {
                  "label": "Azure Key Vault",
                  "value": "vault"
                }
              ]
            }
          },
          {
            "name": "oauth2Credentials",
            "type": "Microsoft.Common.Section",
            "label": "OAuth2 Credentials",
            "elements": [
              {
                "name": "clientId",
                "type": "Microsoft.Common.TextBox",
                "label": "Client ID",
                "toolTip": "CrowdStrike API Client ID from your Falcon console",
                "placeholder": "Enter your CrowdStrike Client ID",
                "constraints": {
                  "required": true,
                  "regex": "^[a-fA-F0-9]{32}$",
                  "validationMessage": "Client ID must be a 32-character hexadecimal string"
                }
              },
              {
                "name": "clientSecret",
                "type": "Microsoft.Common.PasswordBox",
                "label": {
                  "password": "Client Secret",
                  "confirmPassword": "Confirm Client Secret"
                },
                "toolTip": "CrowdStrike API Client Secret from your Falcon console",
                "constraints": {
                  "required": true
                },
                "options": {
                  "hideConfirmation": false
                }
              },
              {
                "name": "apiHelp",
                "type": "Microsoft.Common.InfoBox",
                "visible": true,
                "options": {
                  "icon": "Info",
                  "text": "Get your CrowdStrike API credentials from the Falcon console under Support > API Clients & Keys. Required permissions: Sensor Download [read], Sensor update policies [read], Installation Tokens [read] (optional), Sensor update policies [write] (optional for uninstall).",
                  "uri": "https://falcon.crowdstrike.com/support/api-clients-and-keys"
                }
              }
            ],
            "visible": "[equals(steps('falconConfig').authenticationMethod, 'oauth2')]"
          },
          {
            "name": "tokenCredentials",
            "type": "Microsoft.Common.Section",
            "label": "Access Token",
            "elements": [
              {
                "name": "accessToken",
                "type": "Microsoft.Common.PasswordBox",
                "label": {
                  "password": "Access Token",
                  "confirmPassword": "Confirm Access Token"
                },
                "toolTip": "CrowdStrike API Access Token",
                "constraints": {
                  "required": true
                },
                "options": {
                  "hideConfirmation": false
                }
              }
            ],
            "visible": "[equals(steps('falconConfig').authenticationMethod, 'token')]"
          },
          {
            "name": "vaultCredentials",
            "type": "Microsoft.Common.Section",
            "label": "Azure Key Vault Configuration",
            "elements": [
              {
                "name": "azureVaultName",
                "type": "Microsoft.Common.TextBox",
                "label": "Key Vault Name",
                "toolTip": "Name of the Azure Key Vault containing your CrowdStrike credentials",
                "placeholder": "my-crowdstrike-vault",
                "constraints": {
                  "required": true,
                  "regex": "^[a-zA-Z0-9-]{3,24}$",
                  "validationMessage": "Vault name must be 3-24 characters, letters, numbers, and hyphens only"
                }
              },
              {
                "name": "managedIdentityInfo",
                "type": "Microsoft.Common.InfoBox",
                "visible": true,
                "options": {
                  "icon": "Info",
                  "text": "Store secrets in your Key Vault with these names: FALCON-CLIENT-ID, FALCON-CLIENT-SECRET, FALCON-ACCESS-TOKEN. VMs will use their managed identity to retrieve credentials. Ensure VMs have Key Vault access permissions.",
                  "uri": "https://learn.microsoft.com/azure/key-vault/general/assign-access-policy"
                }
              }
            ],
            "visible": "[equals(steps('falconConfig').authenticationMethod, 'vault')]"
          },
          {
            "name": "basicSettings",
            "type": "Microsoft.Common.Section",
            "label": "Basic Settings",
            "elements": [
              {
                "name": "cloud",
                "type": "Microsoft.Common.DropDown",
                "label": "CrowdStrike Cloud",
                "defaultValue": "Auto-discover",
                "toolTip": "CrowdStrike cloud region for your environment",
                "constraints": {
                  "allowedValues": [
                    {
                      "label": "Auto-discover",
                      "value": "autodiscover"
                    },
                    {
                      "label": "US-1",
                      "value": "us-1"
                    },
                    {
                      "label": "US-2",
                      "value": "us-2"
                    },
                    {
                      "label": "EU-1",
                      "value": "eu-1"
                    },
                    {
                      "label": "US-GOV-1",
                      "value": "us-gov-1"
                    }
                  ]
                }
              },
              {
                "name": "sensorUpdatePolicy",
                "type": "Microsoft.Common.TextBox",
                "label": "Sensor Update Policy",
                "defaultValue": "platform_default",
                "toolTip": "Sensor update policy name from your CrowdStrike console. Change this to match your organization's policy instead of using the default.",
                "constraints": {
                  "required": true
                }
              },
              {
                "name": "tags",
                "type": "Microsoft.Common.TextBox",
                "label": "Sensor Tags",
                "defaultValue": "",
                "toolTip": "Comma-separated list of tags to apply to sensors (e.g., 'azure,production,policy-deployed')",
                "placeholder": "azure,production,policy-deployed"
              }
            ]
          }
        ]
      },
      {
        "name": "deploymentOptions",
        "label": "Deployment Options",
        "elements": [
          {
            "name": "operatingSystem",
            "type": "Microsoft.Common.DropDown",
            "label": "Operating Systems",
            "defaultValue": "Both Linux and Windows",
            "toolTip": "Select which operating systems to deploy policies for",
            "constraints": {
              "allowedValues": [
                {
                  "label": "Both Linux and Windows",
                  "value": "both"
                },
                {
                  "label": "Linux only",
                  "value": "linux"
                },
                {
                  "label": "Windows only",
                  "value": "windows"
                }
              ]
            }
          },
          {
            "name": "deployToArc",
            "type": "Microsoft.Common.CheckBox",
            "label": "Deploy to Azure Arc servers",
            "toolTip": "Include policies for Azure Arc-connected servers in addition to Azure VMs and VMSS"
          },
          {
            "name": "policyEffect",
            "type": "Microsoft.Common.DropDown",
            "label": "Policy Effect",
            "defaultValue": "DeployIfNotExists",
            "toolTip": "Choose the policy behavior: DeployIfNotExists automatically installs sensors, AuditIfNotExists only reports compliance, Disabled turns off the policy",
            "constraints": {
              "allowedValues": [
                {
                  "label": "DeployIfNotExists (Recommended)",
                  "value": "DeployIfNotExists"
                },
                {
                  "label": "AuditIfNotExists",
                  "value": "AuditIfNotExists"
                },
                {
                  "label": "Disabled",
                  "value": "Disabled"
                }
              ]
            }
          },
          {
            "name": "enforcementMode",
            "type": "Microsoft.Common.DropDown",
            "label": "Enforcement Mode",
            "defaultValue": "Default",
            "toolTip": "Default enforces the policy immediately. DoNotEnforce creates the assignment but doesn't enforce compliance until you change it later.",
            "constraints": {
              "allowedValues": [
                {
                  "label": "Default (Enforce immediately)",
                  "value": "Default"
                },
                {
                  "label": "DoNotEnforce",
                  "value": "DoNotEnforce"
                }
              ]
            }
          },
          {
            "name": "createRoleAssignments",
            "type": "Microsoft.Common.CheckBox",
            "label": "Automatically create role assignments",
            "toolTip": "Automatically assign required permissions to policy managed identities. Disable if you lack Owner/User Access Administrator permissions and will assign roles manually."
          }
        ]
      },
      {
        "name": "advancedOptions",
        "label": "Advanced Options",
        "elements": [
          {
            "name": "memberCid",
            "type": "Microsoft.Common.TextBox",
            "label": "Member CID (MSSP)",
            "defaultValue": "",
            "toolTip": "For MSSP scenarios: specify the child CID when using parent API credentials",
            "placeholder": "Leave empty unless using MSSP parent/child setup"
          },
          {
            "name": "provisioningToken",
            "type": "Microsoft.Common.PasswordBox",
            "label": {
              "password": "Provisioning Token (Linux)",
              "confirmPassword": "Confirm Provisioning Token"
            },
            "toolTip": "Installation token for Linux sensors (if required by your environment)",
            "options": {
              "hideConfirmation": false
            }
          },
          {
            "name": "proxyConfiguration",
            "type": "Microsoft.Common.Section",
            "label": "Proxy Configuration",
            "elements": [
              {
                "name": "proxyHost",
                "type": "Microsoft.Common.TextBox",
                "label": "Proxy Host",
                "toolTip": "HTTP proxy hostname or IP address",
                "placeholder": "proxy.company.com"
              },
              {
                "name": "proxyPort",
                "type": "Microsoft.Common.TextBox",
                "label": "Proxy Port",
                "toolTip": "HTTP proxy port number",
                "placeholder": "8080",
                "constraints": {
                  "regex": "^$|^([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
                  "validationMessage": "Must be a valid port number (1-65535) or empty"
                }
              },
              {
                "name": "pacUrl",
                "type": "Microsoft.Common.TextBox",
                "label": "PAC URL (Windows)",
                "toolTip": "Proxy auto-configuration URL for Windows sensors",
                "placeholder": "http://proxy.company.com/proxy.pac"
              }
            ]
          }
        ]
      }
    ],
    "outputs": {
      "operatingSystem": "[steps('deploymentOptions').operatingSystem]",
      "policyDefinitionNamePrefix": "CS-Falcon-Policy",
      "policyEffect": "[steps('deploymentOptions').policyEffect]",
      "createRoleAssignments": "[steps('deploymentOptions').createRoleAssignments]",
      "deployToArc": "[steps('deploymentOptions').deployToArc]",
      "extensionSettings": {
        "handlerVersion": "0.0",
        "autoUpgradeMinorVersion": true
      },
      "clientId": "[if(equals(steps('falconConfig').authenticationMethod, 'oauth2'), steps('falconConfig').oauth2Credentials.clientId, '')]",
      "clientSecret": "[if(equals(steps('falconConfig').authenticationMethod, 'oauth2'), steps('falconConfig').oauth2Credentials.clientSecret, '')]",
      "accessToken": "[if(equals(steps('falconConfig').authenticationMethod, 'token'), steps('falconConfig').tokenCredentials.accessToken, '')]",
      "azureVaultName": "[if(equals(steps('falconConfig').authenticationMethod, 'vault'), steps('falconConfig').vaultCredentials.azureVaultName, '')]",
      "cloud": "[steps('falconConfig').basicSettings.cloud]",
      "memberCid": "[steps('advancedOptions').memberCid]",
      "sensorUpdatePolicy": "[steps('falconConfig').basicSettings.sensorUpdatePolicy]",
      "disableProxy": false,
      "provisioningToken": "[steps('advancedOptions').provisioningToken]",
      "azureManagedIdentityClientId": "",
      "azureManagedIdentityResourceId": "",
      "proxySettings": {
        "proxyHost": "[steps('advancedOptions').proxyConfiguration.proxyHost]",
        "proxyPort": "[steps('advancedOptions').proxyConfiguration.proxyPort]"
      },
      "tags": "[steps('falconConfig').basicSettings.tags]",
      "pacUrl": "[steps('advancedOptions').proxyConfiguration.pacUrl]",
      "disableProvisioningWait": false,
      "disableStart": false,
      "provisioningWaitTime": "1200000",
      "vdi": false,
      "enforcementMode": "[steps('deploymentOptions').enforcementMode]",
      "notScopes": [],
      "location": "[location()]"
    }
  }
}